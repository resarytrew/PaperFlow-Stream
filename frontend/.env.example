# local: use same-origin Vite/FastAPI; cloud: discover only private-network Hub URLs
VITE_PAPERFLOW_UI_MODE=local

# Comma-separated candidates. Production cloud builds should use locally trusted HTTPS.
VITE_PAPERFLOW_HUB_URLS=https://127.0.0.1:17841,https://localhost:17841

# Optional exact hostnames for a future school LAN Hub, e.g. paperflow.school.local
VITE_PAPERFLOW_ALLOWED_HUB_HOSTS=
