# local: use same-origin Vite/FastAPI; cloud: discover only private-network Hub URLs
VITE_PAPERFLOW_UI_MODE=local

# Comma-separated candidates. Chromium-class browsers can request loopback-network
# permission for HTTP localhost; locally trusted HTTPS remains the strongest option.
VITE_PAPERFLOW_HUB_URLS=https://127.0.0.1:17841,https://localhost:17841,http://127.0.0.1:17841,http://localhost:17841

# Optional exact hostnames for a future school LAN Hub, e.g. chistovik.school.local
VITE_PAPERFLOW_ALLOWED_HUB_HOSTS=

# Public download links shown when the local module is not installed.
VITE_PAPERFLOW_HUB_DOWNLOAD_URL=https://github.com/resarytrew/PaperFlow-Stream/releases/download/v0.3.1-pilot/ChistovikSetup-0.3.2.exe
VITE_PAPERFLOW_HUB_RELEASES_URL=https://github.com/resarytrew/PaperFlow-Stream/releases/tag/v0.3.1-pilot
